{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "LLM output for prompts/master-import.md. Every property is required (use \"\" or [] when absent) and there are no union types, to stay within the structured-output limits of 24 optional and 16 union-typed properties per request. ImportMapper turns this into a master resume; the strict master schema then validates the result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["basics", "work", "projects", "education", "skills", "certificates", "awards", "languages", "volunteer", "extras", "warnings"],
  "properties": {
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "email", "phone", "url", "city", "countryCode", "profiles", "summary", "workAuthorization"],
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string", "description": "Headline under the name, e.g. Software Engineer" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "url": { "type": "string", "description": "Personal website, if any" },
        "city": { "type": "string" },
        "countryCode": { "type": "string" },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["network", "username", "url"],
            "properties": {
              "network": { "enum": ["LinkedIn", "GitHub", "Portfolio", "Other"] },
              "username": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        },
        "summary": { "type": "string", "description": "The resume's summary or profile paragraph, verbatim" },
        "workAuthorization": { "enum": ["EP_REQUIRED", "EP_HOLDER", "PR", "CITIZEN", "OTHER", ""] }
      }
    },
    "work": { "type": "array", "items": { "$ref": "#/$defs/experience" } },
    "volunteer": { "type": "array", "items": { "$ref": "#/$defs/experience" } },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "url", "startDate", "endDate", "description", "highlights", "keywords"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "url": { "type": "string" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "description": { "type": "string" },
          "highlights": { "type": "array", "items": { "$ref": "#/$defs/highlight" } },
          "keywords": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution", "area", "studyType", "startDate", "endDate", "score", "scoreScale", "courses", "highlights"],
        "properties": {
          "institution": { "type": "string" },
          "area": { "type": "string", "description": "Field of study, e.g. Mechanical Engineering" },
          "studyType": { "type": "string", "description": "Qualification, e.g. Master of Engineering" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "score": { "type": "string", "description": "Grade or GPA as written" },
          "scoreScale": { "type": "string", "description": "e.g. 5.0 for a GPA out of 5" },
          "courses": { "$ref": "#/$defs/stringList" },
          "highlights": { "type": "array", "items": { "$ref": "#/$defs/highlight" } }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category"],
        "properties": {
          "name": { "type": "string" },
          "category": { "enum": ["Languages", "Frameworks", "Cloud/DevOps", "Databases", "Tools", "Domain", "Soft"] }
        }
      }
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "issuer", "date", "url"],
        "properties": {
          "name": { "type": "string" },
          "issuer": { "type": "string" },
          "date": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "awarder", "date", "summary"],
        "properties": {
          "title": { "type": "string" },
          "awarder": { "type": "string" },
          "date": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "fluency"],
        "properties": {
          "language": { "type": "string" },
          "fluency": { "type": "string" }
        }
      }
    },
    "extras": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text", "date"],
        "properties": {
          "type": { "enum": ["publication", "leadership", "cca", "other"] },
          "text": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    },
    "warnings": { "$ref": "#/$defs/stringList" }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string" } },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "label"],
      "properties": {
        "value": { "type": "string", "description": "The number exactly as written" },
        "unit": { "type": "string", "description": "e.g. %, ms, users; empty if none" },
        "label": { "type": "string", "description": "What it measures, e.g. latency reduction" }
      }
    },
    "highlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "metrics", "skills"],
      "properties": {
        "text": { "type": "string", "description": "One bullet point, verbatim" },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
        "skills": { "$ref": "#/$defs/stringList" }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "position", "location", "employmentType", "startDate", "endDate", "summary", "highlights"],
      "properties": {
        "name": { "type": "string", "description": "Employer or organisation" },
        "position": { "type": "string" },
        "location": { "type": "string" },
        "employmentType": { "enum": ["Internship", "Full-time", "Contract", "Part-time", ""] },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "summary": { "type": "string" },
        "highlights": { "type": "array", "items": { "$ref": "#/$defs/highlight" } }
      }
    }
  }
}
